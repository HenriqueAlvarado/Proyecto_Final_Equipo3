{
  "name": "medisync-backend",
  "version": "1.0.0",
  "description": "API REST para MediSync - Clínica San Ángel",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "pm2": "pm2 start src/index.js --name medisync-api",
    "test": "jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "dependencies": {
    "axios": "1.6.8",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.2",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.13",
    "pg": "8.11.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "3.1.0",
    "supertest": "^6.3.4"
  }
}
